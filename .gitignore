# Build artifacts
/target/
**/target/

# Dependency lock for libraries that have not been released yet.
# TunnelProxy ships binaries (see DEBT-003), so this will be removed
# before the first release. Until then we keep `Cargo.lock` local to
# avoid committing a file we plan to change policy on.
Cargo.lock

# Local environment
.env
.env.*
!.env.example

# Editor / IDE noise
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs / runtime
*.log
